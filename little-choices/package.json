{
  "name": "scroll-film",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "studio": "remotion studio",
    "stills": "bash scripts/stills.sh",
    "animatic": "remotion render Film out/animatic.mp4 --scale=0.5 --props='{\"fps\":10}' --concurrency=4",
    "render": "remotion render Film out/scroll_video.mp4 --codec=h264 --crf=18 --concurrency=4 --muted",
    "mix": "bash scripts/mix.sh",
    "render:vertical": "remotion render FilmVertical out/scroll_vertical_video.mp4 --codec=h264 --crf=18 --concurrency=4 --muted",
    "animatic:vertical": "remotion render FilmVertical out/animatic_vertical.mp4 --scale=0.5 --props='{\"fps\":10}' --concurrency=4 --muted",
    "thumbnails": "bash scripts/thumbnails.sh",
    "channel-art": "bash scripts/channel_art.sh",
    "later:stills": "bash scripts/later_stills.sh",
    "later:animatic": "remotion render LaterFilm out/later/animatic.mp4 --scale=0.5 --props='{\"fps\":10}' --concurrency=4 --muted",
    "later:render": "remotion render LaterFilm out/later/later_video.mp4 --codec=h264 --crf=18 --concurrency=4 --muted",
    "later:mix": "FILM=later bash scripts/mix.sh",
    "later:render:vertical": "remotion render LaterVertical out/later/later_vertical_video.mp4 --codec=h264 --crf=18 --concurrency=4 --muted",
    "later:thumbnails": "bash scripts/later_thumbnails.sh",
    "later:srt": "python3 scripts/make_srt_later.py"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.546",
    "@remotion/fonts": "^4.0.546",
    "@remotion/renderer": "^4.0.546",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.546"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}